{
  "name": "nomi",
  "description": "Your digital companion that quietly understands your day.",
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && npm run sync-dist",
    "sync-dist": "rm -rf dist/nomi && mkdir -p dist/nomi && cp -R .output/chrome-mv3/. dist/nomi/",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "dexie": "^4.0.8",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wxt": "^0.19.13"
  }
}
